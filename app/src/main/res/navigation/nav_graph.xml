<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navGraph"
    app:startDestination="@id/weatherFragment">

    <fragment
        android:id="@+id/weatherFragment"
        android:name="com.example.weather.weather.WeatherFragment"
        android:label="@string/weather_title"
        tools:layout="@layout/fragment_weather">

        <action
            android:id="@+id/action_weatherFragment_to_cityPickerFragment"
            app:destination="@id/cityPickerFragment" />
    </fragment>

    <fragment
        android:id="@+id/cityPickerFragment"
        android:name="com.example.weather.weather.citypicker.CityPickerFragment"
        android:label="@string/city_picker_title"
        tools:layout="@layout/fragment_city_picker" />

</navigation>

