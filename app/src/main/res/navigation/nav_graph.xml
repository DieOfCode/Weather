<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navGraph"
    app:startDestination="@id/weatherFragment">

    <fragment
        android:id="@+id/weatherFragment"
        android:name="com.example.weather.weather.WeatherFragment"
        android:label="@string/weather_title"
        tools:layout="@layout/fragment_weather">

        <action
            android:id="@+id/action_weatherFragment_to_cityPickerFragment"
            app:destination="@id/cityPickerFragment" />

        <action
            android:id="@+id/action_weatherFragment_to_hourlyForecastFragment"
            app:destination="@id/hourlyForecastFragment" />
    </fragment>

    <fragment
        android:id="@+id/cityPickerFragment"
        android:name="com.example.weather.weather.citypicker.CityPickerFragment"
        android:label="@string/city_picker_title"
        tools:layout="@layout/fragment_city_picker" />

    <fragment
        android:id="@+id/hourlyForecastFragment"
        android:name="com.example.weather.weather.hourly.HourlyForecastFragment"
        android:label="@string/hourly_forecast_title"
        tools:layout="@layout/fragment_hourly_forecast">

        <argument
            android:name="cityId"
            app:argType="string" />

        <argument
            android:name="dateEpochDay"
            app:argType="long" />
    </fragment>

</navigation>

